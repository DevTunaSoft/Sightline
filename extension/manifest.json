{
  "manifest_version": 3,
  "name": "Sightline",
  "version": "0.1.0",
  "description": "Local-first visual browser agent that can see, understand, and safely act on webpages.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Sightline"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-agent.js",
        "page-observer.js",
        "page-observer-core.js",
        "ref-registry.js",
        "dom-action-adapter.js",
        "action-protocol.js",
        "action-executor-core.js",
        "safety-gate.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
